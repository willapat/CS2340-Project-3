# Copy to .env (gitignored) and fill in. Never commit real keys.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Add your story's variables below with a short comment (e.g. LLM provider/key, Chroma path).

# US-04: directory for the persistent Chroma vector DB (default: ./chroma_db)
CHROMA_PATH=

# US-06: LLM (Gemini). Free key at https://aistudio.google.com/apikey. Required for real answers.
GEMINI_API_KEY=
# Optional overrides (defaults shown in rag/llm.py and rag/retrieval.py):
# LLM_MODEL=gemini-flash-latest
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT=60
# RAG_TOP_K=5              # passages retrieved per question
# RAG_MIN_SCORE=0.25       # below this relevance a passage is ignored; no passages -> no answer

# US-01 production only (ignored when DJANGO_DEBUG=true):
# Set to false only if the host doesn't serve HTTPS.
DJANGO_SECURE_SSL_REDIRECT=
# 0 until HTTPS is confirmed working; then e.g. 3600.
DJANGO_SECURE_HSTS_SECONDS=
