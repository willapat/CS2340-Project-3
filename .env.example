# Copy to .env (gitignored) and fill in. Never commit real keys.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Add your story's variables below with a short comment (e.g. LLM provider/key, Chroma path).

# US-04: directory for the persistent Chroma vector DB (default: ./chroma_db)
CHROMA_PATH=
